# Ignore secrets
.env

# Python-related
__pycache__/
*.pyc
.venv/
app/backend/.venv
.dockerignore

# Node modules (if mistakenly added in root)
node_modules/


# ---------- Logging (runtime log files) ----------
# only useful for each runtime session for troubleshooting/debugging
global_app_logs/
app/backend/logs/

# Coverage Testing
.coverage
htmlcov/
coverage.xml
/app/backend/exports
.vercel

# Foglamp scan artifacts (contains editToken)
.foglamp/

# Vercel deploy bundle: generated by scripts/build-vercel-bundle.sh
# (source files in deploy-vercel/api + deploy-vercel/vercel.json ARE committed;
# the assembled backend copy and frontend build output are not)
deploy-vercel/backend/
deploy-vercel/public/
deploy-vercel/staticfiles/
.venv-deploy/
