# =======================
# Example ENV File for ExamVault
# =======================
# Copy this file to `.env` and fill in the values before running the app.
# -----------------------
# APP MODE / SECURITY
# -----------------------
DEBUG=False
SECRET_KEY=[generate-strong-random-secret-key]
ALLOWED_HOSTS=[your-vercel-domain.com],[your-api-domain.com]
CORS_ALLOW_ALL_ORIGINS=False
# Set these in production when using specific origins
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
# CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.com

# -----------------------
# DATABASE CONFIGURATION
# -----------------------
POSTGRES_DB=examvault
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# For managed Postgres (e.g., Supabase), set DATABASE_URL and optionally DB_SSL_REQUIRED
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DB_SSL_REQUIRED=True

# -----------------------
# DJANGO CONFIGURATION
# -----------------------

# -----------------------
# EMAIL CONFIGURATION
# -----------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For real SMTP (example using Gmail)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_email_password

# -----------------------
# FRONTEND CONFIGURATION
# -----------------------
FRONTEND_URL=http://localhost
# For deployed frontend:
# FRONTEND_URL=https://your-frontend-domain.com

# -----------------------
# JWT CONFIGURATION
# -----------------------
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME=60      # Minutes
JWT_REFRESH_TOKEN_LIFETIME=1440   # Minutes (1 day)

# -----------------------
# OPTIONAL SECURITY FLAGS
# -----------------------
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# -----------------------
# OPTIONAL DEV SUPERUSER SEED
# -----------------------
# For local development only - use environment variables in production
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_NAME=Admin
DJANGO_SUPERUSER_PASSWORD=change-me-local-only
SEED_SUPERUSER_ON_STARTUP=true
